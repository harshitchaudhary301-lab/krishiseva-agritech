# ==============================================================================
# KrishiSeva Git Ignore Configuration
# ==============================================================================

# Python / Django
__pycache__/
*.py[cod]
*$py.class
*.sqlite3
db.sqlite3
backend/db.sqlite3
media/
staticfiles/
*.log
local_settings.py

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Node / Vite / Frontend
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment Secrets & Configuration
# Ignore all .env files EXCEPT .env.example
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Operating System & IDE
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Testing & Coverage
.coverage
htmlcov/
.pytest_cache/
