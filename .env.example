# ==============================================================================
# KrishiSeva Platform — Environment Variables Configuration Guide
# ==============================================================================
# Copy this file to .env for local development or configure these variables
# directly in your production dashboards (Render for Backend, Vercel for Frontend).
# NEVER commit your real .env file containing live production secrets!
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND SETTINGS (Django / Render)
# ------------------------------------------------------------------------------

# Required in production. Django cryptographic signing key.
# Generate a random 50+ character string for production:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=dev-only-secret-key-change-this-for-production-deployment-2026

# Set to True for local development; MUST be False in production
DEBUG=True

# Comma-separated list of hostnames allowed to access Django.
# Local dev: localhost,127.0.0.1
# Production (Render): .onrender.com,your-service-name.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Database connection string.
# Leave blank or commented out in local dev to automatically use SQLite (db.sqlite3).
# On Render: Render automatically populates this when linked to a PostgreSQL database.
# Example: postgresql://user:password@hostname:5432/krishiseva_db
DATABASE_URL=

# Deployed React frontend URL
# Used by Django to authorize CORS and CSRF tokens
# Example: https://krishiseva-agritech.vercel.app
FRONTEND_URL=http://localhost:5173

# Comma-separated origins allowed to make API requests via CORS
# Example: http://localhost:5173,https://krishiseva-agritech.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Comma-separated trusted origins for CSRF validation
# Example: http://localhost:5173,https://krishiseva-agritech.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Redirect all HTTP requests to HTTPS (True in production, False in local dev)
SECURE_SSL_REDIRECT=False

# ------------------------------------------------------------------------------
# FRONTEND SETTINGS (React / Vite / Vercel)
# ------------------------------------------------------------------------------

# Base URL for the Django REST Framework API.
# Local dev: http://127.0.0.1:8000/api
# Production (Vercel): https://your-render-service.onrender.com/api
VITE_API_BASE_URL=http://127.0.0.1:8000/api
